   "height": 214
  },
  {
   "id": "b17c02388cd40d58",
   "type": "text",
   "text": "**Первый вопрос, ждём ответ**",
   "x": 920,
   "y": 0,
   "width": 400,
   "height": 40
  },
  {
   "id": "7b4795a3e1356616",
   "type": "text",
   "text": "Что поправить: Тоже самое. \n",
